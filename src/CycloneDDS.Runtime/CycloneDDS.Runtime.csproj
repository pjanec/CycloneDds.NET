<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8600;CS8601;CS8603;CS8604;CS1591</NoWarn>
    <!-- IntelliSense for package users: the XML doc file is packed next to the DLL. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CycloneDDS.NET</PackageId>
    <Description>Cyclone DDS Runtime bindings for .NET (Windows x64, Linux x64)</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime: Native Assets — Windows -->
    <None Include="..\..\artifacts\native\win-x64\ddsc.dll" Pack="true" PackagePath="runtimes/win-x64/native" Condition="Exists('..\..\artifacts\native\win-x64\ddsc.dll')" />

    <!-- Runtime: Native Assets — Linux. DllImport("ddsc") resolves to libddsc.so
         from runtimes/linux-x64/native at load time on Linux. Exists-guarded so a
         Windows-only local pack (no linux artifacts) doesn't fail; the CI pack job
         downloads the linux-x64 artifacts before packing. -->
    <None Include="..\..\artifacts\native\linux-x64\libddsc.so" Pack="true" PackagePath="runtimes/linux-x64/native"
          Condition="Exists('..\..\artifacts\native\linux-x64\libddsc.so')" />
    <!-- The SONAME file (libddsc.so.11 since the Cyclone DDS 11 upgrade; it was .so.0): a glob, so a future SONAME bump needs no edit here. -->
    <None Include="..\..\artifacts\native\linux-x64\libddsc.so.*" Pack="true" PackagePath="runtimes/linux-x64/native" />

    <!-- Runtime: DDS Security plugins. ddsc loads them by bare name, and only when the
         domain configuration has a <Security> section. Linux: dlopen() resolves them
         through libddsc.so's RUNPATH ($ORIGIN), so sitting next to it here is enough.
         Windows: LoadLibrary() searches the application directory, so they are also
         copied there by IncludeCycloneDdsSecurityPlugins in CycloneDDS.targets.
         They need OpenSSL 3 at runtime, which is NOT shipped (see README). -->
    <None Include="..\..\artifacts\native\win-x64\dds_security_*.dll" Pack="true" PackagePath="runtimes/win-x64/native" />
    <None Include="..\..\artifacts\native\linux-x64\libdds_security_*.so" Pack="true" PackagePath="runtimes/linux-x64/native" />

    <!-- Build: Targets (buildTransitive → imported by direct AND transitive consumers) -->
    <None Include="..\..\build\targets\CycloneDDS.targets" Pack="true" PackagePath="buildTransitive/CycloneDDS.NET.targets" />
    <!-- Build: direct-reference marker (build/ → imported ONLY by direct consumers).
         Enables the code generator only for projects that directly reference the package. -->
    <None Include="..\..\build\props\CycloneDDS.props" Pack="true" PackagePath="build/CycloneDDS.NET.props" />

    <!-- Tools: Native Assets (Explicitly selected) -->
    <None Include="..\..\artifacts\native\win-x64\idlc.exe" Pack="true" PackagePath="tools/" Condition="Exists('..\..\artifacts\native\win-x64\idlc.exe')" />
    <None Include="..\..\artifacts\native\win-x64\cycloneddsidl.dll" Pack="true" PackagePath="tools/" Condition="Exists('..\..\artifacts\native\win-x64\cycloneddsidl.dll')" />
    <None Include="..\..\artifacts\native\win-x64\cycloneddsidlc.dll" Pack="true" PackagePath="tools/" Condition="Exists('..\..\artifacts\native\win-x64\cycloneddsidlc.dll')" />
    <None Include="..\..\artifacts\native\win-x64\cycloneddsidljson.dll" Pack="true" PackagePath="tools/" Condition="Exists('..\..\artifacts\native\win-x64\cycloneddsidljson.dll')" />
    <None Include="..\..\artifacts\native\win-x64\ddsc.dll" Pack="true" PackagePath="tools/" Condition="Exists('..\..\artifacts\native\win-x64\ddsc.dll')" />

    <!-- Tools: Native Assets — Linux (idlc + its .so dependencies, flat in tools/).
         The .so globs are skipped silently when the linux-x64 artifacts are absent;
         idlc is Exists-guarded for the same reason. -->
    <None Include="..\..\artifacts\native\linux-x64\idlc" Pack="true" PackagePath="tools/"
          Condition="Exists('..\..\artifacts\native\linux-x64\idlc')" />
    <None Include="..\..\artifacts\native\linux-x64\*.so" Pack="true" PackagePath="tools/"
          Exclude="..\..\artifacts\native\linux-x64\libdds_security_*.so" />
    <None Include="..\..\artifacts\native\linux-x64\*.so.*" Pack="true" PackagePath="tools/" />

    <!-- Tools: Shared Managed Libraries -->
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.Compiler.Common.dll" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.Compiler.Common.pdb" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.Core.dll" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.Core.pdb" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.Schema.dll" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.Schema.pdb" Pack="true" PackagePath="tools/" />

    <!-- Tools: CodeGen -->
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.CodeGen.exe" Pack="true" PackagePath="tools/" Condition="Exists('..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.CodeGen.exe')" />
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.CodeGen.dll" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.CodeGen.pdb" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.CodeGen.deps.json" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\CycloneDDS.CodeGen.runtimeconfig.json" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\Microsoft.CodeAnalysis.dll" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.CodeGen\bin\$(Configuration)\net8.0\Microsoft.CodeAnalysis.CSharp.dll" Pack="true" PackagePath="tools/" />

    <!-- Tools: IdlImporter -->
    <None Include="..\..\tools\CycloneDDS.IdlImporter\bin\$(Configuration)\net8.0\CycloneDDS.IdlImporter.exe" Pack="true" PackagePath="tools/" Condition="Exists('..\..\tools\CycloneDDS.IdlImporter\bin\$(Configuration)\net8.0\CycloneDDS.IdlImporter.exe')" />
    <None Include="..\..\tools\CycloneDDS.IdlImporter\bin\$(Configuration)\net8.0\CycloneDDS.IdlImporter.dll" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.IdlImporter\bin\$(Configuration)\net8.0\CycloneDDS.IdlImporter.pdb" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.IdlImporter\bin\$(Configuration)\net8.0\CycloneDDS.IdlImporter.deps.json" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.IdlImporter\bin\$(Configuration)\net8.0\CycloneDDS.IdlImporter.runtimeconfig.json" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.IdlImporter\bin\$(Configuration)\net8.0\System.CommandLine.dll" Pack="true" PackagePath="tools/" />
    <None Include="..\..\tools\CycloneDDS.IdlImporter\CycloneDDS.IdlImporter.ps1" Pack="true" PackagePath="tools/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CycloneDDS.Core\CycloneDDS.Core.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\CycloneDDS.Schema\CycloneDDS.Schema.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\..\tools\CycloneDDS.CodeGen\CycloneDDS.CodeGen.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\CycloneDDS.Core.dll" Pack="true" PackagePath="lib\$(TargetFramework)" Visible="false" />
    <None Include="$(OutputPath)\CycloneDDS.Schema.dll" Pack="true" PackagePath="lib\$(TargetFramework)" Visible="false" />
    <!-- Their XML docs too, so the attributes and core types show their documentation in the editor. -->
    <None Include="$(OutputPath)\CycloneDDS.Core.xml" Pack="true" PackagePath="lib\$(TargetFramework)" Visible="false"
          Condition="Exists('$(OutputPath)\CycloneDDS.Core.xml')" />
    <None Include="$(OutputPath)\CycloneDDS.Schema.xml" Pack="true" PackagePath="lib\$(TargetFramework)" Visible="false"
          Condition="Exists('$(OutputPath)\CycloneDDS.Schema.xml')" />
    <!-- Ship the SourceLink-enabled PDBs next to their DLLs so consumers can debug
         into CycloneDDS.Core / CycloneDDS.Schema too (not just CycloneDDS.Runtime).
         These are manually-packed project-reference outputs, so their symbols are
         not auto-collected into the symbol package. -->
    <None Include="$(OutputPath)\CycloneDDS.Core.pdb" Pack="true" PackagePath="lib\$(TargetFramework)" Visible="false"
          Condition="Exists('$(OutputPath)\CycloneDDS.Core.pdb')" />
    <None Include="$(OutputPath)\CycloneDDS.Schema.pdb" Pack="true" PackagePath="lib\$(TargetFramework)" Visible="false"
          Condition="Exists('$(OutputPath)\CycloneDDS.Schema.pdb')" />
  </ItemGroup>

  <Import Project="..\..\build\targets\NativeVersionInfo.targets" />

  <Import Project="..\..\tools\CycloneDDS.CodeGen\CycloneDDS.targets" />

</Project>
